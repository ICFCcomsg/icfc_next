# Frappe backend: CRM (enquiries and marketing preferences) and the LMS course calendar.
# For the calendar, the key's user needs read access to LMS Batch and LMS Batch Enrollment.
CRM_API_HOST=
CRM_API_KEY=
CRM_API_SECRET=

# Tracking and chat
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_FRAPPE_CHAT_SRC=

# Search engine verification (meta tags; leave empty to skip, or use DNS records instead)
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_BAIDU_VERIFICATION=

# Where enquiry notifications go (needs an outgoing Email Account in Frappe)
ENQUIRY_NOTIFY_TO=admin@icfc.com.sg
